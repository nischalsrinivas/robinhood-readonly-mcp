{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "robinhood-readonly-mcp",
  "title": "Robinhood Readonly MCP",
  "description": "Read-only research tools for Robinhood portfolio data",
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "robinhood-readonly-mcp",
      "version": "0.1.2",
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "tools": [
    {
      "name": "robinhood_get_portfolio",
      "description": "Get portfolio value and performance"
    },
    {
      "name": "robinhood_get_positions",
      "description": "Get current stock holdings"
    },
    {
      "name": "robinhood_get_position",
      "description": "Get one stock holding"
    },
    {
      "name": "robinhood_get_watchlist",
      "description": "Get watchlist stocks"
    },
    {
      "name": "robinhood_get_quote",
      "description": "Get real-time stock quote"
    },
    {
      "name": "robinhood_get_fundamentals",
      "description": "Get P/E, market cap, dividends"
    },
    {
      "name": "robinhood_get_historicals",
      "description": "Get price history"
    },
    {
      "name": "robinhood_get_news",
      "description": "Get stock news"
    },
    {
      "name": "robinhood_get_earnings",
      "description": "Get earnings dates and estimates"
    },
    {
      "name": "robinhood_get_ratings",
      "description": "Get analyst ratings"
    },
    {
      "name": "robinhood_get_dividends",
      "description": "Get dividend payment history"
    },
    {
      "name": "robinhood_get_options_positions",
      "description": "Get options positions"
    },
    {
      "name": "robinhood_get_available_expirations",
      "description": "Get available option expiration dates"
    },
    {
      "name": "robinhood_get_option_chain",
      "description": "Get read-only option chain data"
    },
    {
      "name": "robinhood_get_options_by_expiration_and_strike",
      "description": "Get options for an expiration and strike"
    },
    {
      "name": "robinhood_search_symbols",
      "description": "Search for stock symbols"
    }
  ]
}
